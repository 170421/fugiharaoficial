# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_SECRET=seu_jwt_secret_super_seguro_aqui

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL="postgresql://farma:farma123@localhost:5432/farma_whatsapp"

# ─── Cache / Queue (Redis) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── WhatsApp Meta Cloud API ──────────────────────────────────────────────────
# Obtenha em: https://developers.facebook.com/apps/
META_APP_ID=seu_app_id_aqui
META_APP_SECRET=seu_app_secret_aqui

# Token de acesso permanente (System User Token)
META_ACCESS_TOKEN=seu_access_token_permanente_aqui

# ID do número de telefone registrado no WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id_aqui

# ID da conta WhatsApp Business
WHATSAPP_BUSINESS_ACCOUNT_ID=seu_business_account_id_aqui

# Versão da API Graph do Facebook
META_API_VERSION=v19.0

# ─── Webhook ──────────────────────────────────────────────────────────────────
# Token para verificação do webhook (você define este valor)
WEBHOOK_VERIFY_TOKEN=seu_token_verificacao_webhook_aqui

# ─── Rate Limiting (disparos por segundo para evitar ban) ─────────────────────
# Meta permite ~80 msgs/seg no tier mais alto
MESSAGES_PER_SECOND=10
MESSAGES_PER_MINUTE=250
